# NVIDIA GPU layer — built on top of the base gaming image
ARG BASE_IMAGE=fedora-gaming:latest
FROM ${BASE_IMAGE}

LABEL quay.expires-after=12w

# Add negativo17 NVIDIA repository (latest drivers)
RUN dnf config-manager addrepo --from-repofile=https://negativo17.org/repos/fedora-nvidia.repo && \
    dnf config-manager setopt "fedora-nvidia".priority=4 && \
    dnf clean all

# Install NVIDIA kernel module build dependencies and compile kmod at build time.
# This is similar to what Bazzite does via ublue-os/akmods, but simplified:
# we install akmod-nvidia and compile against the image's kernel right here.
RUN KERNEL_VERSION=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel) && \
    dnf install -y \
        akmod-nvidia \
        akmods \
        kernel-devel-matched && \
    akmods --force --kernels "${KERNEL_VERSION}" --kmod nvidia && \
    modinfo /usr/lib/modules/"${KERNEL_VERSION}"/extra/nvidia/nvidia{,-drm,-modeset,-peermem,-uvm}.ko* && \
    dnf remove -y akmods kernel-devel-matched && \
    dnf clean all

# Install NVIDIA userspace driver packages (64-bit and 32-bit for Proton/Wine)
RUN dnf install -y \
        nvidia-driver \
        nvidia-driver-libs.x86_64 \
        nvidia-driver-libs.i686 \
        nvidia-driver-cuda \
        nvidia-driver-cuda-libs.x86_64 \
        nvidia-driver-cuda-libs.i686 \
        nvidia-kmod-common \
        nvidia-settings \
        nvidia-modprobe \
        nvidia-persistenced && \
    dnf clean all

# Install NVIDIA Wayland, VA-API, and container support
RUN dnf install -y \
        egl-wayland.x86_64 \
        egl-wayland.i686 \
        libva-nvidia-driver \
        nvidia-container-toolkit && \
    dnf clean all

# Install 32-bit Mesa libs for Proton/Wine hybrid GPU compatibility
RUN dnf install -y \
        mesa-dri-drivers.i686 \
        mesa-filesystem.i686 \
        mesa-libEGL.i686 \
        mesa-libGL.i686 \
        mesa-libgbm.i686 \
        mesa-vulkan-drivers.i686 && \
    dnf clean all

# Remove open-source nouveau firmware (not needed with proprietary driver)
# and nouveau Vulkan ICD (conflicts with NVIDIA proprietary Vulkan)
RUN dnf remove -y nvidia-gpu-firmware 2>/dev/null || true && \
    rm -f /usr/share/vulkan/icd.d/nouveau_icd.*.json

# Create libnvidia-ml.so symlink for NVML consumers (e.g. nvtop, lact)
RUN ln -sf libnvidia-ml.so.1 /usr/lib64/libnvidia-ml.so

# Configure dracut to force-load NVIDIA modules early in initramfs
# This prevents black screen on boot and ensures KMS is active from the start.
RUN mkdir -p /usr/lib/dracut/dracut.conf.d && \
    printf 'force_drivers+=" nvidia nvidia-drm nvidia-modeset nvidia-uvm "\n' \
        > /usr/lib/dracut/dracut.conf.d/99-nvidia.conf

# Enable nvidia-drm modeset for KMS (required for Wayland and Sunshine KMS capture)
RUN mkdir -p /usr/lib/modprobe.d && \
    printf 'options nvidia-drm modeset=1 fbdev=1\n' \
        > /usr/lib/modprobe.d/nvidia-modeset.conf

# Copy system configuration files and scripts
# (done late so that rootfs/ edits don't bust the package install cache)
COPY rootfs/ /
COPY host-scripts/ /usr/local/bin/

# Enable systemd services
# (must run after rootfs/ is copied: reads custom preset and unit files from there)
RUN systemctl preset-all && \
    systemctl --global preset-all && \
    systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
