# NVIDIA GPU layer — built on top of the base gaming image
ARG BASE_IMAGE=fedora-gaming:latest
FROM ${BASE_IMAGE}

LABEL quay.expires-after=12w

# Add negativo17 NVIDIA repository (latest drivers) and NVIDIA Container Toolkit repo
RUN dnf config-manager addrepo --from-repofile=https://negativo17.org/repos/fedora-nvidia.repo && \
    dnf config-manager setopt "fedora-nvidia".priority=4 && \
    dnf config-manager addrepo --from-repofile=https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo && \
    dnf install -y 'dnf5-command(copr)' && \
    dnf copr enable -y jpietek/penguin-burner && \
    dnf clean all

# Install NVIDIA driver packages (userspace + kernel module builder).
# negativo17 defaults to open kernel modules since driver 560+ (Turing/RTX 20xx+).
# kernel-devel-matched is needed to compile the kmod at build time; removed after.
RUN dnf install -y \
        nvidia-driver \
        nvidia-driver-libs.x86_64 \
        nvidia-driver-libs.i686 \
        nvidia-driver-cuda \
        nvidia-driver-cuda-libs.x86_64 \
        nvidia-driver-cuda-libs.i686 \
        nvidia-kmod-common \
        nvidia-settings \
        nvidia-modprobe \
        nvidia-persistenced \
        akmods \
        kernel-devel-matched && \
    KERNEL_VERSION=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel) && \
    akmods --force --kernels "${KERNEL_VERSION}" --kmod nvidia && \
    modinfo /usr/lib/modules/"${KERNEL_VERSION}"/extra/nvidia/nvidia{,-drm,-modeset,-peermem,-uvm}.ko* && \
    dnf remove -y akmods kernel-devel-matched && \
    dnf clean all

# Install NVIDIA Wayland, VA-API, and container toolkit support
RUN dnf install -y \
        egl-wayland.x86_64 \
        egl-wayland.i686 \
        egl-wayland2.x86_64 \
        egl-wayland2.i686 \
        libva-nvidia-driver \
        penguin-burner \
        nvidia-container-toolkit && \
    dnf clean all

# Install 32-bit Mesa libs for Proton/Wine hybrid GPU compatibility
RUN dnf install -y \
        mesa-dri-drivers.i686 \
        mesa-filesystem.i686 \
        mesa-libEGL.i686 \
        mesa-libGL.i686 \
        mesa-libgbm.i686 \
        mesa-vulkan-drivers.i686 && \
    dnf clean all

# Remove open-source nouveau firmware (not needed with proprietary driver)
# and nouveau Vulkan ICD (conflicts with NVIDIA proprietary Vulkan)
RUN dnf remove -y nvidia-gpu-firmware 2>/dev/null || true && \
    rm -f /usr/share/vulkan/icd.d/nouveau_icd.*.json

# Create libnvidia-ml.so symlink for NVML consumers (e.g. nvtop, lact)
RUN ln -sf libnvidia-ml.so.1 /usr/lib64/libnvidia-ml.so

# Configure dracut to force-load NVIDIA modules early in initramfs
# This prevents black screen on boot and ensures KMS is active from the start.
# Also omit AMD/Nouveau drivers to prevent conflicts.
RUN mkdir -p /usr/lib/dracut/dracut.conf.d && \
    printf 'force_drivers+=" nvidia nvidia-drm nvidia-modeset nvidia-uvm "\n' \
        > /usr/lib/dracut/dracut.conf.d/99-nvidia.conf && \
    printf 'omit_drivers+=" amdgpu radeon nouveau "\n' \
        > /usr/lib/dracut/dracut.conf.d/blacklist-other-gpu.conf

# Enable nvidia-drm modeset for KMS (required for Wayland and Sunshine KMS capture)
# Also blacklist AMD/Nouveau drivers to prevent module loading conflicts
RUN mkdir -p /usr/lib/modprobe.d && \
    printf 'options nvidia-drm modeset=1 fbdev=1\n' \
        > /usr/lib/modprobe.d/nvidia-modeset.conf && \
    printf '# Blacklist AMD GPU drivers on NVIDIA-only systems\nblacklist amdgpu\nblacklist radeon\n# Blacklist Nouveau\nblacklist nouveau\n' \
        > /usr/lib/modprobe.d/blacklist-other-gpu.conf

# Prevent CUDA from forcing P2 state instead of P0 for apps that use NVENC.
# Without this, WiVRn, Sunshine, OBS, etc. keep the GPU in P2 under load.
# See: https://github.com/WiVRn/WiVRn/blob/master/docs/nvenc.md
#      https://github.com/NVIDIA/open-gpu-kernel-modules/issues/333
RUN mkdir -p /etc/nvidia/nvidia-application-profiles-rc.d && \
    printf '%s\n' \
        '{' \
        '    "rules": [' \
        '        { "pattern": "wivrn-server",          "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "sunshine",              "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "obs",                   "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "gpu-screen-recorder",   "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "spectacle",             "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "Discord",               "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "discord",               "profile": "CudaNoStablePerfLimit" },' \
        '        { "pattern": "vesktop",               "profile": "CudaNoStablePerfLimit" }' \
        '    ],' \
        '    "profiles": [' \
        '        {' \
        '            "name": "CudaNoStablePerfLimit",' \
        '            "settings": [' \
        '                { "key": "0x166c5e", "value": 0 }' \
        '            ]' \
        '        }' \
        '    ]' \
        '}' \
        > /etc/nvidia/nvidia-application-profiles-rc.d/cuda-no-stable-perf-limit

# Workaround for kernel 7.0 composefs/overlay SELinux denials:
# composefs backing-file mmap checks cause userspace mappings to be evaluated
# as kernel_t, breaking execmem for games/Wine/Proton on NVIDIA.
# Tracking: https://github.com/ublue-os/akmods/issues/537
COPY rootfs/usr/share/selinux/packages/composefs_execmem.te /tmp/composefs_execmem.te
RUN dnf install -y selinux-policy-devel && \
    checkmodule -M -m -o /tmp/composefs_execmem.mod /tmp/composefs_execmem.te && \
    semodule_package -o /tmp/composefs_execmem.pp -m /tmp/composefs_execmem.mod && \
    (semodule -X 300 -i /tmp/composefs_execmem.pp || (rm -rf /etc/selinux/targeted/tmp && semodule -X 300 -i /tmp/composefs_execmem.pp)) && \
    rm -f /tmp/composefs_execmem.{te,mod,pp} && \
    dnf remove -y selinux-policy-devel && \
    dnf clean all

# Copy system configuration files and scripts
# (done late so that rootfs/ edits don't bust the package install cache)
COPY rootfs/ /
COPY host-scripts/ /usr/local/bin/

# Enable systemd services
# (must run after rootfs/ is copied: reads custom preset and unit files from there)
RUN systemctl preset-all && \
    systemctl --global preset-all
