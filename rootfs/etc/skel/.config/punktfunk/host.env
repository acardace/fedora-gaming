# Punktfunk host configuration — this box runs Polaris (a Sunshine-family Moonlight
# host) alongside Punktfunk, so the two must not collide on ports.
#
# Polaris's web UI owns TCP 47990. Punktfunk's management API defaults to that same
# port and treats failing to bind it as fatal (it exits), so move it to 47991.
# Clients learn the port from mDNS discovery; the web console, tray and plugin runner
# read it from ~/.config/punktfunk/mgmt-endpoint, which the host rewrites on start.
PUNKTFUNK_MGMT_BIND=0.0.0.0:47991

# Moonlight/GameStream compatibility stays OFF while Polaris is installed. With it on,
# Punktfunk would bind Polaris's own GameStream ports (TCP 47984/47989/48010, UDP
# 47998-48000) and advertise the same _nvstream mDNS name — only one Moonlight host can
# run at a time. Turn it on (PUNKTFUNK_GAMESTREAM=1) only after Polaris is removed.
PUNKTFUNK_GAMESTREAM=0
