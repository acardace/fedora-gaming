disable app-dev.lizardbyte.app.Sunshine.service
disable sunshine.service
enable polaris.service
# Punktfunk streaming host (coexists with Polaris; mgmt port moved to 47991, see
# /etc/skel/.config/punktfunk/host.env). Host + web console + game-library runner.
enable punktfunk-host.service
enable punktfunk-web.service
enable punktfunk-scripting.service
enable podman.socket
enable ludusavi-backup.timer
